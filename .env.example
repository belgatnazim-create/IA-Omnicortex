# Obtenir une clé API OpenAI :
# 1) Créez un compte sur https://platform.openai.com/ et connectez-vous.
# 2) Dans "API Keys", générez une nouvelle clé.
OPENAI_API_KEY=your_api_key_here
# Optionnel: modèle par défaut
OPENAI_MODEL=gpt-4o-mini

# Google Sheets Service Account
# Créez un compte de service dans Google Cloud, puis téléchargez la clé JSON.
# Copiez le contenu JSON dans cette variable ou utilisez GOOGLE_SERVICE_ACCOUNT_KEYFILE.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# ID de la feuille de calcul Google Sheets. Exemple : 1aBcD...XyZ
SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
# Nom de l'onglet à utiliser pour l'export
SHEETS_SHEET_NAME=Sheet1
